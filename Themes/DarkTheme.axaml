<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="MainBg" Color="Black"/>
    <SolidColorBrush x:Key="MenuBg" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="MenuBorder" Color="#0F0F0F"/>
    <SolidColorBrush x:Key="HoverBg" Color="#222222"/>
    <SolidColorBrush x:Key="SelectedBg" Color="#333333"/>
    <SolidColorBrush x:Key="TextPrimary" Color="White"/>
    <SolidColorBrush x:Key="TextAccent" Color="Cyan"/>
</ResourceDictionary>