<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="MainBg" Color="#000000"/>
    <SolidColorBrush x:Key="MenuBg" Color="#050505"/>
    <SolidColorBrush x:Key="MenuBorder" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="CardBg" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="CardBorder" Color="#222222"/>
    <SolidColorBrush x:Key="HoverBg" Color="#181818"/>
    <SolidColorBrush x:Key="SelectedBg" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#888888"/>
    <SolidColorBrush x:Key="TextAccent" Color="#E1E1E1"/>

</ResourceDictionary>