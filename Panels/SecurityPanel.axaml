<UserControl x:Class="Black_Hole_Cross.Panels.SecurityPanel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:Black_Hole_Cross"
             xmlns:services="using:Black_Hole_Cross.Services"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             >

    <UserControl.Styles>
        <Style Selector="Border">
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
    </UserControl.Styles>

    <Border Background="#0A0A1A" CornerRadius="15" Padding="25" BoxShadow="0 0 25 0 #FF6B6B">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Border Grid.Row="0" Background="Transparent" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Viewbox Width="28" Height="28" Margin="0,0,15,0">
                        <TextBlock Text="🛡️" Foreground="#FF6B6B"/>
                    </Viewbox>
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[SecurityPanelTitle]}"
                                  Foreground="#FF6B6B"
                                  FontSize="18"
                                  FontWeight="Bold"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[SecurityPanelSubtitle]}"
                                  Foreground="#A0A0FF"
                                  FontSize="10"
                                  HorizontalAlignment="Center"
                                  Margin="0,5,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Список будущих функций -->
            <Border Grid.Row="1" Background="#1A1A2E" CornerRadius="12" Padding="20" BorderThickness="1" BorderBrush="#2A2A4A">
                <StackPanel>
                    <!-- Мониторинг активности -->
                    <Border Background="#2A2A3A" CornerRadius="8" Padding="15" Margin="0,0,0,12"
                       BorderThickness="1" BorderBrush="#FF6B6B">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="22" Height="22" Margin="0,0,12,0">
                                <TextBlock Text="👁️" VerticalAlignment="Center"/>
                            </Viewbox>
                            <StackPanel>
                                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[ActivityMonitorTitle]}"
                                      FontSize="11"
                                      FontWeight="Bold"
                                      Foreground="#FF6B6B"/>
                                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[ActivityMonitorDescription]}"
                                      FontSize="9"
                                      Foreground="#CCCCCC"
                                      TextWrapping="Wrap"
                                      Margin="0,2,0,0"
                                      FontStyle="Italic"/>
                                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[ActivityMonitorFeatures]}"
                                      FontSize="8"
                                      Foreground="#888888"
                                      TextWrapping="Wrap"
                                      Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Проверка процессов -->
                    <Border Background="#2A2A3A" CornerRadius="8" Padding="15" Margin="0,0,0,12"
                       BorderThickness="1" BorderBrush="#FF4444">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="22" Height="22" Margin="0,0,12,0">
                                <TextBlock Text="🔍" VerticalAlignment="Center"/>
                            </Viewbox>
                            <StackPanel>
                                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[ProcessScannerTitle]}"
                                      FontSize="11"
                                      FontWeight="Bold"
                                      Foreground="#FF4444"/>
                                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[ProcessScannerDescription]}"
                                      FontSize="9"
                                      Foreground="#CCCCCC"
                                      TextWrapping="Wrap"
                                      Margin="0,2,0,0"
                                      FontStyle="Italic"/>
                                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[ProcessScannerFeatures]}"
                                      FontSize="8"
                                      Foreground="#888888"
                                      TextWrapping="Wrap"
                                      Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Анализ сетевых подключений -->
                    <Border Background="#2A2A3A" CornerRadius="8" Padding="15" Margin="0,0,0,12"
                       BorderThickness="1" BorderBrush="#FFD700">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="22" Height="22" Margin="0,0,12,0">
                                <TextBlock Text="🌐" VerticalAlignment="Center"/>
                            </Viewbox>
                            <StackPanel>
                                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[NetworkAnalysisTitle]}"
                                      FontSize="11"
                                      FontWeight="Bold"
                                      Foreground="#FFD700"/>
                                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[NetworkAnalysisDescription]}"
                                      FontSize="9"
                                      Foreground="#CCCCCC"
                                      TextWrapping="Wrap"
                                      Margin="0,2,0,0"
                                      FontStyle="Italic"/>
                                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[NetworkAnalysisFeatures]}"
                                      FontSize="8"
                                      Foreground="#888888"
                                      TextWrapping="Wrap"
                                      Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Быстрое сканирование -->
                    <Border Background="#2A2A3A" CornerRadius="8" Padding="15" Margin="0,0,0,12"
                       BorderThickness="1" BorderBrush="#00FF88">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="22" Height="22" Margin="0,0,12,0">
                                <TextBlock Text="⚡" VerticalAlignment="Center"/>
                            </Viewbox>
                            <StackPanel>
                                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[QuickScanTitle]}"
                                      FontSize="11"
                                      FontWeight="Bold"
                                      Foreground="#00FF88"/>
                                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[QuickScanDescription]}"
                                      FontSize="9"
                                      Foreground="#CCCCCC"
                                      TextWrapping="Wrap"
                                      Margin="0,2,0,0"
                                      FontStyle="Italic"/>
                                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[QuickScanFeatures]}"
                                      FontSize="8"
                                      Foreground="#888888"
                                      TextWrapping="Wrap"
                                      Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Защита в реальном времени -->
                    <Border Background="#2A2A3A" CornerRadius="8" Padding="15" Margin="0,0,0,12"
                       BorderThickness="1" BorderBrush="#9370DB">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="22" Height="22" Margin="0,0,12,0">
                                <TextBlock Text="🔄" VerticalAlignment="Center"/>
                            </Viewbox>
                            <StackPanel>
                                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[RealTimeProtectionTitle]}"
                                      FontSize="11"
                                      FontWeight="Bold"
                                      Foreground="#9370DB"/>
                                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[RealTimeProtectionDescription]}"
                                      FontSize="9"
                                      Foreground="#CCCCCC"
                                      TextWrapping="Wrap"
                                      Margin="0,2,0,0"
                                      FontStyle="Italic"/>
                                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[RealTimeProtectionFeatures]}"
                                      FontSize="8"
                                      Foreground="#888888"
                                      TextWrapping="Wrap"
                                      Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Шифрование файлов -->
                    <Border Background="#2A2A3A" CornerRadius="8" Padding="15"
                       BorderThickness="1" BorderBrush="#4050B0">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="22" Height="22" Margin="0,0,12,0">
                                <TextBlock Text="🔐" VerticalAlignment="Center"/>
                            </Viewbox>
                            <StackPanel>
                                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[FileEncryptionTitle]}"
                                      FontSize="11"
                                      FontWeight="Bold"
                                      Foreground="#4050B0"/>
                                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[FileEncryptionDescription]}"
                                      FontSize="9"
                                      Foreground="#CCCCCC"
                                      TextWrapping="Wrap"
                                      Margin="0,2,0,0"
                                      FontStyle="Italic"/>
                                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[FileEncryptionFeatures]}"
                                      FontSize="8"
                                      Foreground="#888888"
                                      TextWrapping="Wrap"
                                      Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Нижний текст -->
            <Border Grid.Row="2" Background="Transparent" Margin="0,15,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[SecurityPanelFooterTitle]}"
                          Foreground="#A0A0FF"
                          FontSize="10"
                          FontWeight="SemiBold"
                          HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[SecurityPanelFooterDescription]}"
                          Foreground="#888888"
                          FontSize="8"
                          HorizontalAlignment="Center"
                          Margin="0,3,0,0"
                          FontStyle="Italic"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
