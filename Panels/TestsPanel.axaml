<UserControl x:Class="Black_Hole_Cross.TestsPanel"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:Black_Hole_Cross"
             xmlns:services="using:Black_Hole_Cross.Services"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             x:CompileBindings="False">

    <UserControl.Styles>
        <Style Selector="Border">
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
    </UserControl.Styles>

    <Border Background="#0A0A1A" CornerRadius="15" Padding="25" BoxShadow="0 0 25 0 #4050B0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Border Grid.Row="0" Background="Transparent" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Viewbox Width="28" Height="28" Margin="0,0,15,0">
                        <TextBlock Text="🚧" Foreground="#FFD700"/>
                    </Viewbox>
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[TestsPanelTitle]}"
                              Foreground="#FFD700"
                              FontSize="18"
                              FontWeight="Bold"
                              HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[TestsPanelSubtitle]}"
                              Foreground="#A0A0FF"
                              FontSize="10"
                              HorizontalAlignment="Center"
                              Margin="0,5,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Список будущих функций -->
            <Border Grid.Row="1" Background="#1A1A2E" CornerRadius="12" Padding="20" BorderThickness="1" BorderBrush="#2A2A4A">
                <StackPanel>
                    <!-- Стресс-тест CPU -->
                    <Border Background="#2A2A3A" CornerRadius="8" Padding="15" Margin="0,0,0,12"
                       BorderThickness="1" BorderBrush="#4050B0">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="22" Height="22" Margin="0,0,12,0">
                                <TextBlock Text="🔴" VerticalAlignment="Center"/>
                            </Viewbox>
                            <StackPanel>
                                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[StressTestTitle]}"
                                      FontSize="11"
                                      FontWeight="Bold"
                                      Foreground="#FF6B6B"/>
                                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[StressTestDescription]}"
                                      FontSize="9"
                                      Foreground="#87CEEB"
                                      TextWrapping="Wrap"
                                      Margin="0,2,0,0"
                                      FontStyle="Italic"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Тест дисков -->
                    <Border Background="#2A2A3A" CornerRadius="8" Padding="15" Margin="0,0,0,12"
                       BorderThickness="1" BorderBrush="#40B050">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="22" Height="22" Margin="0,0,12,0">
                                <TextBlock Text="💾" VerticalAlignment="Center"/>
                            </Viewbox>
                            <StackPanel>
                                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[DiskTestTitle]}"
                                      FontSize="11"
                                      FontWeight="Bold"
                                      Foreground="#00FF88"/>
                                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[DiskTestDescription]}"
                                      FontSize="9"
                                      Foreground="#87CEEB"
                                      TextWrapping="Wrap"
                                      Margin="0,2,0,0"
                                      FontStyle="Italic"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Диагностика сети -->
                    <Border Background="#2A2A3A" CornerRadius="8" Padding="15" Margin="0,0,0,12"
                       BorderThickness="1" BorderBrush="#9370DB">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="22" Height="22" Margin="0,0,12,0">
                                <TextBlock Text="🌐" VerticalAlignment="Center"/>
                            </Viewbox>
                            <StackPanel>
                                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[NetworkTestTitle]}"
                                      FontSize="11"
                                      FontWeight="Bold"
                                      Foreground="#A0A0FF"/>
                                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[NetworkTestDescription]}"
                                      FontSize="9"
                                      Foreground="#87CEEB"
                                      TextWrapping="Wrap"
                                      Margin="0,2,0,0"
                                      FontStyle="Italic"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Дополнительные функции -->
                    <Border Background="#2A2A3A" CornerRadius="8" Padding="15" Margin="0,0,0,12"
                       BorderThickness="1" BorderBrush="#FFD700">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="22" Height="22" Margin="0,0,12,0">
                                <TextBlock Text="✨" VerticalAlignment="Center"/>
                            </Viewbox>
                            <StackPanel>
                                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[MoreFeaturesTitle]}"
                                      FontSize="11"
                                      FontWeight="Bold"
                                      Foreground="#FFD700"/>
                                <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[MoreFeaturesDescription]}"
                                      FontSize="9"
                                      Foreground="#87CEEB"
                                      TextWrapping="Wrap"
                                      Margin="0,2,0,0"
                                      FontStyle="Italic"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Нижний текст -->
            <Border Grid.Row="2" Background="Transparent" Margin="0,15,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[FollowUpdatesTitle]}"
                          Foreground="#00FF88"
                          FontSize="10"
                          FontWeight="SemiBold"
                          HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[FollowUpdatesDescription]}"
                          Foreground="#A0A0FF"
                          FontSize="8"
                          HorizontalAlignment="Center"
                          Margin="0,3,0,0"
                          FontStyle="Italic"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
