<Window x:Class="Black_Hole_Cross.CalendarWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Black_Hole_Cross"
        Title="Календарь"
        Height="700" 
        Width="900"
        CanResize="False"
        Background="Transparent"
        SystemDecorations="None"
        TransparencyLevelHint="AcrylicBlur"
        WindowStartupLocation="CenterScreen"
        x:CompileBindings="False">

    <Window.DataTemplates>
        <DataTemplate DataType="{x:Type local:CalendarDay}">
            <Border x:Name="DayBorder"
                    Classes="DayCell"
                    PointerPressed="DayBorder_PointerPressed">
                <ToolTip.Tip>
                    <TextBlock Text="{Binding Tooltip}"/>
                </ToolTip.Tip>
                
                <Grid Margin="6,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding DayNumber}" 
                               FontSize="14" FontWeight="Medium" 
                               Foreground="{Binding TextColor}"
                               HorizontalAlignment="Center"/>
                    
                    <TextBlock Grid.Row="1" Text="{Binding HolidayIcon}" 
                               FontSize="20" HorizontalAlignment="Center" 
                               VerticalAlignment="Center" Margin="0,2,0,0"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.DataTemplates>

    <Window.Styles>
       
        <Style Selector="Window">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

     
        <Style Selector="Button.NavBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button.NavBtn:pointerover">
            <Setter Property="Background" Value="#1AFFFFFF"/>
        </Style>
        <Style Selector="Button.NavBtn:pressed">
            <Setter Property="Background" Value="#0FFFFFFF"/>
        </Style>

        <Style Selector="Button.CloseBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="Button.CloseBtn:pointerover">
            <Setter Property="Background" Value="#E81123"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.CloseBtn:pressed">
            <Setter Property="Background" Value="#A8000F"/>
        </Style>

        <Style Selector="Button.AccentBtn">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.AccentBtn:pointerover">
            <Setter Property="Background" Value="#1084D8"/>
        </Style>
        <Style Selector="Button.AccentBtn:pressed">
            <Setter Property="Background" Value="#005A9E"/>
        </Style>

        <Style Selector="Button.DefaultBtn">
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.DefaultBtn:pointerover">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
        </Style>

        <!-- Стили ячеек календаря -->
        <Style Selector="Border.DayCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Height" Value="72"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.DayCell:pointerover">
            <Setter Property="Background" Value="#1AFFFFFF"/>
        </Style>

        <Style Selector="Border.NormalDay">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        
        <Style Selector="Border.OtherMonthDay">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>
        
        <Style Selector="Border.TodayDay">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Border.TodayDay TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Border.NewYearDay">
            <Setter Property="Background" Value="#1AFFD700"/>
            <Setter Property="BorderBrush" Value="#FFD700"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Border.ReligiousDay">
            <Setter Property="Background" Value="#1A9370DB"/>
            <Setter Property="BorderBrush" Value="#9370DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Border.MilitaryDay">
            <Setter Property="Background" Value="#1ACD5C5C"/>
            <Setter Property="BorderBrush" Value="#CD5C5C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Border.FunDay">
            <Setter Property="Background" Value="#1A20B2AA"/>
            <Setter Property="BorderBrush" Value="#20B2AA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Border.SpaceDay">
            <Setter Property="Background" Value="#1A4169E1"/>
            <Setter Property="BorderBrush" Value="#4169E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Border.TechDay">
            <Setter Property="Background" Value="#1A32CD32"/>
            <Setter Property="BorderBrush" Value="#32CD32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Border.BirthdayDay">
            <Setter Property="Background" Value="#1AFF69B4"/>
            <Setter Property="BorderBrush" Value="#FF69B4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>

        <Style Selector="Border.SelectedDay">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Border.SelectedDay TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Styles>

    <Grid Margin="12">
        <Border CornerRadius="8" BorderBrush="#2AFFFFFF" BorderThickness="1">
            <Border.Background>
                <SolidColorBrush Color="#1C1C1C" Opacity="0.98"/>
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок окна -->
                <Border Grid.Row="0" x:Name="TitleBar" Background="Transparent" 
                        PointerPressed="TitleBar_PointerPressed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="📅" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TitleText" Text="Календарь" FontSize="12" Foreground="#E0E0E0" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="─" Classes="NavBtn" Click="MinimizeButton_Click" Width="46"/>
                            <Button Content="☐" Classes="NavBtn" Click="MaximizeButton_Click" Width="46"/>
                            <Button Content="✕" Classes="CloseBtn" Click="CloseButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Контент -->
                <Grid Grid.Row="1" Margin="24,16,24,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Навигация -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                            <Button Content="‹" Classes="NavBtn" Click="PrevMonthBtn_Click" Width="32" FontSize="18"/>
                            <TextBlock x:Name="CurrentMonthText" Text="Сентябрь 2026" FontSize="18" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                            <Button Content="›" Classes="NavBtn" Click="NextMonthBtn_Click" Width="32" FontSize="18"/>
                        </StackPanel>

                        <Button Grid.Column="1" Content="Сегодня" Classes="DefaultBtn" Click="TodayBtn_Click" FontSize="12" Padding="12,6"/>
                    </Grid>

                    <!-- Дни недели -->
                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ПН" Foreground="#666666" HorizontalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                        <TextBlock Grid.Column="1" Text="ВТ" Foreground="#666666" HorizontalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                        <TextBlock Grid.Column="2" Text="СР" Foreground="#666666" HorizontalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                        <TextBlock Grid.Column="3" Text="ЧТ" Foreground="#666666" HorizontalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                        <TextBlock Grid.Column="4" Text="ПТ" Foreground="#666666" HorizontalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                        <TextBlock Grid.Column="5" Text="СБ" Foreground="#0078D4" HorizontalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                        <TextBlock Grid.Column="6" Text="ВС" Foreground="#0078D4" HorizontalAlignment="Center" FontSize="12" FontWeight="Medium"/>
                    </Grid>
                </Grid>

                <!-- Сетка дней -->
                <ItemsControl Grid.Row="2" x:Name="CalendarGrid" Margin="24,0,24,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" Rows="6"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Информационная панель -->
                <Border Grid.Row="3" x:Name="HolidayInfoPanel" 
                        Background="#2A2A2A" BorderBrush="#3A3A3A" BorderThickness="1" 
                        CornerRadius="6" Padding="16" Margin="24,0,24,8" IsVisible="False">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="HolidayIcon" Text="🎉" FontSize="24" VerticalAlignment="Center" Margin="0,0,12,0"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="HolidayName" Text="Название" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock x:Name="HolidayDate" Text="01.01.2026" FontSize="12" Foreground="#888888" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="HolidayDescription" Text="Описание" FontSize="12" Foreground="#AAAAAA"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:Name="HolidayProgress" Height="3" Background="#333333" Foreground="#0078D4" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="DaysUntilText" Text="Через 5 дн." FontSize="11" Foreground="#0078D4" Margin="10,0,0,0"/>
                            </Grid>
                        </StackPanel>

                        <Button Grid.Column="2" Content="✕" Classes="NavBtn" Click="DismissNotification_Click" 
                                VerticalAlignment="Top" Width="28" Height="28" FontSize="12"/>
                    </Grid>
                </Border>

                <!-- Нижняя панель -->
                <Border Grid.Row="4" Background="#141414" BorderBrush="#2A2A2A" BorderThickness="1,0,1,1" 
                        CornerRadius="0,0,8,8" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="EventInputBox" 
                                 Watermark="Добавить напоминание для выбранного дня..." 
                                 Height="32" VerticalContentAlignment="Center" 
                                 Background="#1A1A1A" Foreground="White" 
                                 BorderBrush="#333333" CornerRadius="4"
                                 Padding="12,0"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
                            <Button Content="Сохранить" Classes="AccentBtn" Click="SaveEventBtn_Click" Height="32"/>
                            <Button Content="Удалить" Classes="DefaultBtn" Click="DeleteEventBtn_Click" Height="32"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>