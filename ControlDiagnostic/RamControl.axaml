<UserControl x:Class="Black_Hole_Cross.ControlDiagnostic.RamControl"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:local="using:Black_Hole_Cross"
             mc:Ignorable="d"
             x:CompileBindings="False"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Styles>
      
        <Style Selector="ScrollViewer.ModernScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

       
        <Style Selector="Border.ModernCard">
            <Setter Property="Background" Value="{DynamicResource CardBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="BoxShadow" Value="0 2 20 0 #33000000"/>
        </Style>

       
        <Style Selector="StackPanel.CardHeader">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

       
        <Style Selector="Viewbox.CardIcon">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

      
        <Style Selector="TextBlock.CardTitle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextAccent}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

      
        <Style Selector="TextBlock.CardDescription">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

      
        <Style Selector="Border.ItemBorder:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SelectedBg}"/>
        </Style>
        <Style Selector="Border.ItemBorder:pointerover StackPanel#ActionButtons">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Visible" Classes="ModernScrollViewer">
        <StackPanel>
            <TextBlock x:Name="DiagnosRAM" Text="Диагностика RAM" FontWeight="Bold" FontSize="50" Foreground="{DynamicResource TextPrimary}" Margin="0,50,0,0" HorizontalAlignment="Center"/>
            <Label x:Name="ModelAndManuf" Content="Модель и производитель: " FontSize="20" Foreground="{DynamicResource TextPrimary}" Margin="20,0,0,0"/>
            <TextBlock x:Name="RamInfo" FontSize="18" Foreground="{DynamicResource TextPrimary}" Margin="10" />
            <TextBlock x:Name="RamLiveData" FontSize="18" Foreground="{DynamicResource TextPrimary}" Margin="10" />
            <Label x:Name="UsageRAM" Content="Использование ОЗУ" FontSize="20" Foreground="{DynamicResource TextPrimary}" Margin="20,0,0,0" />

            <lvc:PieChart x:Name="RamPieChart" Height="357" Width="383" HorizontalAlignment="Left" Margin="100,0,0,10" />

      
            <Border Background="{DynamicResource CardBg}" CornerRadius="12" Margin="10" BorderBrush="{DynamicResource CardBorder}"  BorderThickness="1">
                <Grid RowDefinitions="Auto,*">

                  
                    <Border Grid.Row="0" Background="{DynamicResource HoverBg}" CornerRadius="12,12,0,0" Padding="10">
                        <TextBlock Text="📋 История буфера" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold"/>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="5">
                        <ItemsControl ItemsSource="{Binding HistoryList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
    <Border Background="#1E1E1E" CornerRadius="6" x:CompileBindings="False" Margin="0,4" Padding="8"
            PointerEntered="ItemBorder_MouseEnter" PointerExited="ItemBorder_MouseLeave">
        <Grid ColumnDefinitions="*, Auto">
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="{Binding Type}" FontWeight="Bold" Foreground="#4CAF50" FontSize="12"/>
                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" Foreground="White" />
                <TextBlock Text="{Binding TimeLabel}" Foreground="#777" FontSize="10" />
                
             
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                    <Button Content="📋 Скопировать" Click="BtnRestore_Click" FontSize="11" Padding="6,2"/>
                    <Button Content="🗑️ Удалить" Click="BtnDelete_Click" Foreground="#FF5252" FontSize="11" Padding="6,2"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

          <Popup x:Name="PreviewPopup" 
       PlacementMode="Right" 
       PlacementTarget="{Binding #HistoryListBox}" 
       IsLightDismissEnabled="False">
    <Border Background="#222222" 
            BorderBrush="#444444" 
            BorderThickness="1" 
            Padding="10" 
            CornerRadius="8" 
            MaxWidth="300" 
            IsHitTestVisible="False">
        <StackPanel Spacing="6">
            <TextBlock x:Name="PopupTitle" FontWeight="Bold" Foreground="White" FontSize="11"/>

            <!-- Текст -->
            <TextBlock x:Name="PopupText" TextWrapping="Wrap" Foreground="#CCC" MaxHeight="200" IsVisible="False"/>

            <!-- Картинка -->
            <Image x:Name="PopupImage" MaxHeight="200" Stretch="Uniform" IsVisible="False"/>

            <!-- Медиа (Видео/Аудио) -->
            <StackPanel x:Name="PopupMediaPanel" IsVisible="False">
                <TextBlock Text="🎵 Аудио / 🎬 Видео файл" Foreground="#4CAF50" FontSize="11" FontWeight="Bold"/>
                <TextBlock x:Name="PopupMediaInfo" Foreground="#AAA" TextWrapping="Wrap" FontSize="11"/>
            </StackPanel>

            <!-- 3D Модели -->
            <StackPanel x:Name="Popup3DPanel" IsVisible="False">
                <TextBlock Text="🧊 3D Модель (Blender/CAD)" Foreground="#FF9800" FontSize="11" FontWeight="Bold"/>
                <TextBlock x:Name="Popup3DInfo" Foreground="#AAA" TextWrapping="Wrap" FontSize="11"/>
            </StackPanel>

            <!-- Путь к файлу -->
            <TextBlock x:Name="PopupFilePath" TextWrapping="Wrap" Foreground="#888" FontSize="11" IsVisible="False"/>
        </StackPanel>
    </Border>
</Popup>

        </StackPanel>
    </ScrollViewer>
</UserControl>