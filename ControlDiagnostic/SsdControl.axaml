<UserControl x:Class="Black_Hole_Cross.ControlDiagnostic.SsdControl"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="850">

    <UserControl.Styles>
        <Style Selector="Button.ActionBtn">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="6"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="20" RowDefinitions="Auto, Auto, Auto, *">

        <!-- Заголовок -->
        <TextBlock Grid.Row="0"
                   Text="Диагностика накопителей"
                   x:Name="DiagnosDisk"
                   FontSize="32"
                   FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimary}"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,20"/>

        <!-- Панель управления -->
        <WrapPanel Grid.Row="1"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20">
            <Button Content="🧹 Очистить кэш"
                    x:Name="CleanCache"
                    Classes="ActionBtn"
                    Click="CacheClean_Click"/>

            <Button Content="📂 Показать большие файлы"
                    x:Name="ShowBigFiles"
                    Classes="ActionBtn"
                    Click="ShowLargestFiles_Click"/>

            <ComboBox x:Name="Disk"
                      Background="#2A2A2A"
                      Foreground="White"
                      FontSize="15"
                      Margin="6"
                      CornerRadius="8"
                      BorderBrush="#444444"
                      SelectionChanged="ComboBox_SelectedChanged">
            </ComboBox>
        </WrapPanel>

        <!-- Полоса-разделитель -->
        <Border Grid.Row="2"
                Height="1"
                Background="#333333"
                Margin="20,0,20,20"/>

        <!-- Основной контент -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10,0">

                <!-- Живой блок параметров -->
                <Border Background="#252526"
                        BorderBrush="#3E3E42"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,0,0,15">
                    <TextBlock x:Name="DiskInfoDisplay"
                               FontSize="15"
                               Foreground="#4CAF50"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontFamily="Consolas"
                               Text="Сбор системных данных..."/>
                </Border>

                <!-- Контейнер карточек дисков -->
                <WrapPanel x:Name="InfoView"
                           Orientation="Horizontal"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl> 