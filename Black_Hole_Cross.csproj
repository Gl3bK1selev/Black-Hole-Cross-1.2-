<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>Black_Hole_Cross</AssemblyName>
		<RootNamespace>BlackHole</RootNamespace>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<AvaloniaXamlCompileBindingsWithValidation>false</AvaloniaXamlCompileBindingsWithValidation>
		<ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		
	</PropertyGroup>
	<!-- Локализация (json файлы) -->
	<ItemGroup>
		<None Include="Localization\**\*.json" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- Исключение только старого служебного файла -->
	<ItemGroup>
		<Compile Remove="Classes\FixNamespace.cs" />
	</ItemGroup>

	<!-- Пакеты Avalonia и зависимости -->
	
	<ItemGroup>
		<PackageReference Include="Avalonia" Version="11.1.3" />
		<PackageReference Include="Avalonia.Desktop" Version="11.1.3" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="11.1.3" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="11.1.3" />
		<PackageReference Include="Avalonia.Diagnostics" Version="11.1.3" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
		<PackageReference Include="OpenAL.Soft" Version="1.23.1" />
		<PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
		<PackageReference Include="Silk.NET.OpenAL.Extensions.Enumeration" Version="2.23.0" />
		<PackageReference Include="Silk.NET.OpenAL.Extensions.EXT" Version="2.23.0" />
		<PackageReference Include="Silk.NET.OpenAL.Extensions.Soft" Version="2.23.0" />
		<PackageReference Include="System.CodeDom" Version="10.0.11" />
		<PackageReference Include="System.Diagnostics.PerformanceCounter" Version="9.0.0" />
		<PackageReference Include="LibreHardwareMonitorLib" Version="0.9.3" />
		<PackageReference Include="System.Management" Version="9.0.0" />
		<PackageReference Include="LiveChartsCore.SkiaSharpView.Avalonia" Version="2.0.0-rc2" />
		
		<PackageReference Include="System.Configuration.ConfigurationManager" Version="9.0.0" />
	</ItemGroup>
	
	<ItemGroup><AvaloniaResource Include="Themes\*.axaml" /></ItemGroup>
	
	<ItemGroup>
	  <None Remove="Images\Black_holeListBox.png" />
	</ItemGroup>
	
	<ItemGroup>
	  <AvaloniaResource Include="Images\Black_holeListBox.png" />
	</ItemGroup>
	
	<ItemGroup>
	  <Compile Update="ControlDiagnostic\AudioControl.axaml.cs">
	    <DependentUpon>AudioControl.axaml</DependentUpon>
	  </Compile>
	</ItemGroup>
	
	<ItemGroup>
	  <AvaloniaResource Remove="Assets/BlackHoleICON.ico" />
	</ItemGroup>
		
	
</Project>